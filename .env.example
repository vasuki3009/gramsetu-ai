# ═══════════════════════════════════════════════════════════════════════════
# GramSetu backend configuration template
#
#   cp .env.example .env      then replace every placeholder below.
#
# - .env is git-ignored; NEVER commit real values or paste them in issues/logs.
# - `docker compose up --build` reads this file automatically. For a plain
#   `mvn spring-boot:run`, export the same variables in your shell or IDE run
#   configuration (Spring does not read .env files by itself).
# - Frontend variables (VITE_*) live in gramsetu-app/.env.example.
# - Marked REQUIRED = the backend refuses to start (or compose stops) without it.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────────
# Port the backend listens on. Railway and similar platforms inject PORT themselves.
PORT=8081

# Spring profile. Use "dev" locally: SQL logging, DEBUG logs (which include farmers'
# text), a localhost database URL default and the Vite dev origin in CORS. Leave
# EMPTY in production: INFO logs only record lengths, ids and masked phone numbers.
SPRING_PROFILES_ACTIVE=

# ── Database (MySQL 8) ──────────────────────────────────────────────────────
# REQUIRED. Root password for the MySQL container created by docker-compose.
# It only applies when the data volume is first created; changing it later does
# not change an existing volume (use ALTER USER or recreate the volume).
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-password

# Database name (docker-compose default: gramsetu).
MYSQL_DATABASE=gramsetu

# Host port that docker-compose publishes MySQL on (bound to 127.0.0.1 only).
MYSQL_HOST_PORT=3307

# Only for running the backend WITHOUT docker-compose (compose sets these for you).
# REQUIRED in that case, e.g. jdbc:mysql://localhost:3306/gramsetu?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# ── AI providers ────────────────────────────────────────────────────────────
# REQUIRED. Google Gemini key (primary text model by default, and crop-photo diagnosis).
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# REQUIRED. Sarvam AI key (Tamil speech-to-text and text-to-speech).
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key

# OPTIONAL. Sarvam models. Defaults: bulbul:v3 (text-to-speech) and saaras:v3 (speech-to-text).
# bulbul:v2 was retired (HTTP 400 "Model has been deprecated"); saarika:v2 / v2.5 are legacy.
# If you change the TTS model, the speakers in SarvamTtsVoices.java must match it (v3 and v2 names differ).
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v3

# OPTIONAL. Groq key: the fallback when Gemini fails (or the primary when AI_PROVIDER=groq).
# https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL. Dialect used when none can be detected from the message: standard (default), kongu, madurai,
# nellai or chennai. A farmer can override it on WhatsApp with "dialect chennai" etc.
# DEFAULT_DIALECT=standard

# OPTIONAL. Which AI answers text questions first: gemini (default) or groq.
# The other one is used as a fallback only if its key is set. Switch without deleting any key.
AI_PROVIDER=gemini

# OPTIONAL. Gemini model for answers and crop photos. Default gemini-3.8-flash.
# (gemini-2.0-flash was retired on 1 June 2026 and no longer works; gemini-2.5-flash is scheduled to end on 1 Dec 2026.)
# GEMINI_MODEL=gemini-3.8-flash

# OPTIONAL. Models tried (in order) when the primary model keeps failing with 503 "high demand", 429 or timeouts,
# comma-separated. After them Groq is tried if GROQ_API_KEY is set. Set it empty to turn the model fallback off.
# A 429 or 5xx is retried on the same model (AI_RETRY_MAX_ATTEMPTS, default 2, 1 s apart, doubling) while the
# AI_RETRY_BUDGET_MS budget (default 60000) lasts. A timeout moves straight on to the next model, and every model
# always gets at least one attempt. AI_READ_TIMEOUT_MS (default 25000) is the read timeout of one call.
# AI_RETRY_MAX_ATTEMPTS=2
# AI_RETRY_BUDGET_MS=60000
# AI_READ_TIMEOUT_MS=25000
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# OPTIONAL. Gemini thinking level: low (default) | medium | high. "minimal" works on some models but NOT on
# gemini-3.8-flash. Lower = faster answers. Empty = send no setting (model default, slower).
# AI_THINKING_LEVEL=low

# OPTIONAL. Answer randomness (default 0.2: steady, repeatable) and the longest answer in tokens (default 2048).
# AI_TEMPERATURE=0.2
# AI_MAX_OUTPUT_TOKENS=2048

# ── Twilio / WhatsApp ───────────────────────────────────────────────────────
# REQUIRED. Account SID and Auth Token from the Twilio console.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# REQUIRED. WhatsApp sender, in Twilio format (the sandbox number is shown under
# Messaging > Try it out > Send a WhatsApp message).
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# REQUIRED. Public HTTPS base URL of THIS backend, exactly as Twilio calls it
# (no trailing path), e.g. https://your-backend.example.com or your ngrok URL.
# Twilio's X-Twilio-Signature is validated against this URL + /api/whatsapp/webhook,
# so it must match the webhook URL configured in the Twilio console.
APP_PUBLIC_BASE_URL=https://your-backend.example.com

# Reject webhook calls that are not signed by Twilio (default true). Set to false ONLY
# for local curl testing (scripts/test-webhook.bat) and never on a deployed server.
TWILIO_VALIDATE_SIGNATURE=true

# ── Cloudinary (hosts the TTS audio that WhatsApp delivers) ─────────────────
# REQUIRED. https://console.cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── CORS (which websites may call the API from a browser) ───────────────────
# Comma-separated EXACT origins. Empty = no cross-origin access.
# Production: your deployed frontend, e.g. https://gramsetu-livid.vercel.app
# docker-compose defaults to http://localhost:5173 (the Vite dev server) if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OPTIONAL. Comma-separated origin patterns, e.g. this project's Vercel preview
# deployments: https://gramsetu-livid-*-your-team.vercel.app
# Never use a bare *.vercel.app: it would allow every Vercel site.
CORS_ALLOWED_ORIGIN_PATTERNS=

# ── Abuse protection ────────────────────────────────────────────────────────
# Per-IP rate limit on the AI-backed endpoints (ask, voice, crop analysis, ...).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

# How many reverse proxies sit in front of the backend and append the client address
# to X-Forwarded-For. The client IP is taken from that many entries from the RIGHT,
# because left-most entries are forgeable.
#   0 = backend reachable directly (docker-compose default): the header is ignored
#   1 = one platform proxy such as Railway (the application default)
#   2+ = more proxies chained (e.g. CDN + platform): otherwise all clients behind the
#        same proxy share one rate-limit budget
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# ── Request size limits ─────────────────────────────────────────────────────
# Hard ceiling for any uploaded file.
MAX_UPLOAD_SIZE=8MB
# Voice recordings, 2 MB (HTTP 413 when exceeded).
MAX_AUDIO_BYTES=2097152
# Crop photos, 8 MB.
MAX_IMAGE_BYTES=8388608
# Characters in a typed or WhatsApp text question.
MAX_QUESTION_LENGTH=1000

# ── Docker build (optional) ─────────────────────────────────────────────────
# Change the value to force a fresh compile of the source layer.
# CACHEBUST=1
