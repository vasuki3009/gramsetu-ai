# GramSetu frontend — copy to .env.local for local development.
# Vite only exposes variables prefixed with VITE_ and bakes them into the public bundle,
# so never put secrets here.

# Base URL of the GramSetu Spring Boot backend, without a trailing slash.
# REQUIRED in production builds (the app throws on start-up if it is missing).
# In `npm run dev` it defaults to http://localhost:8081 when unset.
VITE_API_BASE_URL=https://your-backend.example.com

# Full WhatsApp join link used by the home-screen button and QR code, for example
# https://wa.me/<whatsapp-number>?text=join%20<sandbox-code>
# Optional: when unset the join button and QR code are hidden.
VITE_WHATSAPP_JOIN_URL=
